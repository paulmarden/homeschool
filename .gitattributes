# Normalise text to LF in the repo; check it out with native line endings.
# (No eol=lf pin: this is a Windows working tree, and pinning only produces
# a "CRLF will be replaced by LF" warning on every git command.)
* text=auto

# Resources are whatever we drop in, so be explicit rather than relying on
# git's content heuristics: a binary mangled by CRLF conversion is a file that
# silently stops opening.
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.mp4   binary
*.mov   binary
*.mp3   binary
*.zip   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.xlsx  binary
*.docx  binary
*.pptx  binary
*.ipynb binary
