# Normalise text in the repo, checked out with native line endings.
* text=auto

# Resources are whatever we drop in, so be explicit rather than relying on
# git's content heuristics: a binary mangled by CRLF conversion is a file that
# silently stops opening.
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.mp4   binary
*.mov   binary
*.mp3   binary
*.zip   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.xlsx  binary
*.docx  binary
*.pptx  binary
*.ipynb binary

# Keep these LF wherever they are checked out.
*.py    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
